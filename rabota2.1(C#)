using System;

class Game
{
    string name;
    int year;
    string zhanr;
    string price;

    public Game(string name, int year, string zhanr, string price)
    {
        this.name = name;
        this.price = price;
        this.year = year;
        this.zhanr = zhanr;
        Console.WriteLine($"Название: {name} \nГод выпуска: {year} \nЖанр: {zhanr} \nЦена: {price}");
    }

    public void ocenka()
    {
        if (year < 2000)
        {
            Console.WriteLine("Старая игра");
        }
    }
}
class Nastolnya : Game
{
    string kolichestvo;
    string duration;

    public Nastolnya(string name, int year, string zhanr, string price, string kolichestvo, string duration) : base(name, year, zhanr, price)
    {
        this.kolichestvo = kolichestvo;
        this.duration = duration;
        Console.WriteLine($"Количество игроков: {kolichestvo} \nвремя игры: {duration}");
    }
}
class Video : Game
{
    string vozrast;
    string device;

    public Video(string name, int year, string zhanr, string price, string vozrast, string device) : base(name, year, zhanr, price)
    {
        this.device = device;
        this.vozrast = vozrast;
        Console.WriteLine($"устройство: {device} \nвозрастное ограничние: {vozrast}");
    }
}
public class Program
{
    public static void Main()
    {
        Nastolnya game1 = new Nastolnya("Дженга", 1982, "Стратегия", "3000", "2-4", "10 минут");
        game1.ocenka();
        Video game2 = new Video("Террария", 2011, "Песочница" , "350", "12+", "Компьютер");
        game2.ocenka();
           
    }
}

